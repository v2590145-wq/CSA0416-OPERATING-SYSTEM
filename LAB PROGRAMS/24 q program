#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/stat.h>
#include <unistd.h>

#define BUFFER_SIZE 1024

int main(void) {
    int choice;
    char filename[256];
    char newName[256];
    char buffer[BUFFER_SIZE];

    while (1) {
        printf("\nUNIX File Management System Calls\n");
        printf("1. Create or open a file\n");
        printf("2. Write to a file (overwrite)\n");
        printf("3. Read a file\n");
        printf("4. Display file information (stat)\n");
        printf("5. Rename a file\n");
        printf("6. Delete a file\n");
        printf("7. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1) {
            fprintf(stderr, "Invalid input.\n");
            return EXIT_FAILURE;
        }

        if (choice == 7)
            break;

        if (choice < 1 || choice > 7) {
            printf("Choose a number from 1 to 7.\n");
            continue;
        }

        printf("Enter filename: ");
        if (scanf("%255s", filename) != 1) {
            fprintf(stderr, "Could not read filename.\n");
            return EXIT_FAILURE;
        }

        int fd;
        ssize_t count;

        switch (choice) {
            case 1:
                fd = open(filename, O_CREAT | O_RDWR, 0644);
                if (fd == -1) {
                    perror("open");
                } else {
                    printf("File opened or created: %s\n", filename);
                    close(fd);
                }
                break;

            case 2:
                fd = open(filename, O_CREAT | O_WRONLY | O_TRUNC, 0644);
                if (fd == -1) {
                    perror("open");
                    break;
                }

                printf("Enter one line of text: ");
                int ch;
                while ((ch = getchar()) != '\n' && ch != EOF) {
                    /* Discard the newline left by scanf. */
                }

                if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
                    fprintf(stderr, "Could not read text.\n");
                } else {
                    size_t length = 0;
                    while (buffer[length] != '\0')
                        length++;

                    count = write(fd, buffer, length);
                    if (count == -1)
                        perror("write");
                    else
                        printf("Wrote %ld bytes.\n", (long)count);
                }
                close(fd);
                break;

            case 3:
                fd = open(filename, O_RDONLY);
                if (fd == -1) {
                    perror("open");
                    break;
                }

                /* lseek resets the file offset to the beginning. */
                if (lseek(fd, 0, SEEK_SET) == (off_t)-1)
                    perror("lseek");

                printf("File contents:\n");
                while ((count = read(fd, buffer, sizeof(buffer))) > 0)
                    (void)write(STDOUT_FILENO, buffer, (size_t)count);

                if (count == -1)
                    perror("read");

                close(fd);
                break;

            case 4: {
                struct stat info;
                if (stat(filename, &info) == -1) {
                    perror("stat");
                } else {
                    printf("Size: %lld bytes\n", (long long)info.st_size);
                    printf("Permissions: %o\n",
                           (unsigned)(info.st_mode & 0777));
                    printf("Regular file: %s\n",
                           S_ISREG(info.st_mode) ? "yes" : "no");
                }
                break;
            }

            case 5:
                printf("Enter new filename: ");
                if (scanf("%255s", newName) != 1) {
                    fprintf(stderr, "Could not read new filename.\n");
                    return EXIT_FAILURE;
                }
                if (rename(filename, newName) == -1)
                    perror("rename");
                else
                    printf("File renamed to %s\n", newName);
                break;

            case 6:
                if (unlink(filename) == -1)
                    perror("unlink");
                else
                    printf("File deleted: %s\n", filename);
                break;
        }
    }

    return EXIT_SUCCESS;
}
