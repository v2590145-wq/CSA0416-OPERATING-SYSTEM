#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>

#define MESSAGE_SIZE 100

struct message {
    long message_type;             /* Must be greater than 0 */
    char text[MESSAGE_SIZE];
};

int main(void) {
    /* Create a private message queue for this program. */
    int queue_id = msgget(IPC_PRIVATE, IPC_CREAT | 0600);
    if (queue_id == -1) {
        perror("msgget");
        return 1;
    }

    pid_t pid = fork();
    if (pid == -1) {
        perror("fork");
        msgctl(queue_id, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        /* Child receives a message of type 1. */
        struct message received;

        if (msgrcv(queue_id, &received, sizeof(received.text),
                   1, 0) == -1) {
            perror("msgrcv");
            exit(1);
        }

        printf("Child received: %s\n", received.text);
        exit(0);
    }

    /* Parent sends a message to the queue. */
    struct message outgoing;
    outgoing.message_type = 1;
    snprintf(outgoing.text, sizeof(outgoing.text),
             "Hello from the parent process!");

    if (msgsnd(queue_id, &outgoing, sizeof(outgoing.text), 0) == -1) {
        perror("msgsnd");
        waitpid(pid, NULL, 0);
        msgctl(queue_id, IPC_RMID, NULL);
        return 1;
    }

    waitpid(pid, NULL, 0);

    /* Remove the queue when it is no longer needed. */
    if (msgctl(queue_id, IPC_RMID, NULL) == -1) {
        perror("msgctl");
        return 1;
    }

    return 0;
}
