#include <pthread.h>
#include <semaphore.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

#define BUFFER_SIZE 5
#define ITEMS_TO_PRODUCE 10

int buffer[BUFFER_SIZE];
int in = 0;
int out = 0;

sem_t empty_slots;
sem_t full_slots;
sem_t mutex;

void *producer(void *arg)
{
    (void)arg;

    for (int item = 1; item <= ITEMS_TO_PRODUCE; item++) {
        sem_wait(&empty_slots);  // Wait for an empty buffer slot
        sem_wait(&mutex);        // Enter critical section

        buffer[in] = item;
        printf("Produced: %d\n", item);
        in = (in + 1) % BUFFER_SIZE;

        sem_post(&mutex);        // Leave critical section
        sem_post(&full_slots);   // Signal that an item is available

        sleep(1);
    }

    return NULL;
}

void *consumer(void *arg)
{
    (void)arg;

    for (int i = 0; i < ITEMS_TO_PRODUCE; i++) {
        sem_wait(&full_slots);   // Wait for an available item
        sem_wait(&mutex);        // Enter critical section

        int item = buffer[out];
        printf("Consumed: %d\n", item);
        out = (out + 1) % BUFFER_SIZE;

        sem_post(&mutex);        // Leave critical section
        sem_post(&empty_slots);  // Signal that a slot is available

        sleep(2);
    }

    return NULL;
}

int main(void)
{
    pthread_t producer_thread, consumer_thread;

    if (sem_init(&empty_slots, 0, BUFFER_SIZE) != 0 ||
        sem_init(&full_slots, 0, 0) != 0 ||
        sem_init(&mutex, 0, 1) != 0) {
        perror("sem_init");
        return EXIT_FAILURE;
    }

    if (pthread_create(&producer_thread, NULL, producer, NULL) != 0 ||
        pthread_create(&consumer_thread, NULL, consumer, NULL) != 0) {
        perror("pthread_create");
        return EXIT_FAILURE;
    }

    pthread_join(producer_thread, NULL);
    pthread_join(consumer_thread, NULL);

    sem_destroy(&empty_slots);
    sem_destroy(&full_slots);
    sem_destroy(&mutex);

    return EXIT_SUCCESS;
}
