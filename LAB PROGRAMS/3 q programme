#include <stdio.h>

int main(void)
{
    int n;
    int burst[100], waiting[100], turnaround[100];
    double total_waiting = 0, total_turnaround = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Number of processes must be between 1 and 100.\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        printf("Enter execution time for P%d: ", i + 1);
        scanf("%d", &burst[i]);

        if (burst[i] < 0) {
            printf("Execution time cannot be negative.\n");
            return 1;
        }
    }

    waiting[0] = 0;
    for (int i = 1; i < n; i++)
        waiting[i] = waiting[i - 1] + burst[i - 1];

    for (int i = 0; i < n; i++) {
        turnaround[i] = waiting[i] + burst[i];
        total_waiting += waiting[i];
        total_turnaround += turnaround[i];
    }

    printf("\nFCFS schedule: ");
    for (int i = 0; i < n; i++)
        printf("P%d%s", i + 1, i == n - 1 ? "\n" : " -> ");

    printf("\nProcess\tExecution\tWaiting\tTurnaround\n");
    for (int i = 0; i < n; i++)
        printf("P%d\t%d\t\t%d\t%d\n",
               i + 1, burst[i], waiting[i], turnaround[i]);

    printf("\nAverage waiting time: %.2f\n", total_waiting / n);
    printf("Average turnaround time: %.2f\n", total_turnaround / n);

    return 0;
}
