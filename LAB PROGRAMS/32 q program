#include <stdio.h>

int main(void) {
    int n, frameCount;

    printf("Enter the number of pages: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid number of pages.\n");
        return 1;
    }

    int pages[n];
    printf("Enter the page reference string: ");
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &pages[i]) != 1) {
            printf("Invalid page reference.\n");
            return 1;
        }
    }

    printf("Enter the number of frames: ");
    if (scanf("%d", &frameCount) != 1 || frameCount <= 0) {
        printf("Invalid number of frames.\n");
        return 1;
    }

    int frames[frameCount];
    int lastUsed[frameCount];

    for (int i = 0; i < frameCount; i++) {
        frames[i] = -1;
        lastUsed[i] = -1;
    }

    int pageFaults = 0;

    printf("\nPage\tFrames\t\tStatus\n");

    for (int i = 0; i < n; i++) {
        int page = pages[i];
        int found = -1;

        for (int j = 0; j < frameCount; j++) {
            if (frames[j] == page) {
                found = j;
                break;
            }
        }

        if (found != -1) {
            /* Page hit: update its most recent use time. */
            lastUsed[found] = i;
            printf("%d\t", page);
        } else {
            /* Page fault: use an empty frame, or replace the LRU page. */
            pageFaults++;
            int target = -1;

            for (int j = 0; j < frameCount; j++) {
                if (frames[j] == -1) {
                    target = j;
                    break;
                }
            }

            if (target == -1) {
                target = 0;
                for (int j = 1; j < frameCount; j++) {
                    if (lastUsed[j] < lastUsed[target]) {
                        target = j;
                    }
                }
            }

            frames[target] = page;
            lastUsed[target] = i;
            printf("%d\t", page);
        }

        for (int j = 0; j < frameCount; j++) {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        printf("\t%s\n", found != -1 ? "Hit" : "Page Fault");
    }

    printf("\nTotal page faults: %d\n", pageFaults);
    printf("Total page hits: %d\n", n - pageFaults);

    return 0;
}
