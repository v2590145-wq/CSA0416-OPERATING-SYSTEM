#include <stdio.h>

#define MAX_BLOCKS 100
#define MAX_PROCESSES 100

int main(void)
{
    int block_size[MAX_BLOCKS];
    int process_size[MAX_PROCESSES];
    int allocation[MAX_PROCESSES];
    int blocks, processes;

    printf("Enter number of memory blocks: ");
    if (scanf("%d", &blocks) != 1 || blocks < 1 || blocks > MAX_BLOCKS) {
        printf("Invalid number of blocks.\n");
        return 1;
    }

    printf("Enter sizes of %d memory blocks:\n", blocks);
    for (int i = 0; i < blocks; i++) {
        if (scanf("%d", &block_size[i]) != 1 || block_size[i] < 0) {
            printf("Invalid block size.\n");
            return 1;
        }
    }

    printf("Enter number of processes: ");
    if (scanf("%d", &processes) != 1 ||
        processes < 1 || processes > MAX_PROCESSES) {
        printf("Invalid number of processes.\n");
        return 1;
    }

    printf("Enter sizes of %d processes:\n", processes);
    for (int i = 0; i < processes; i++) {
        if (scanf("%d", &process_size[i]) != 1 || process_size[i] < 0) {
            printf("Invalid process size.\n");
            return 1;
        }
        allocation[i] = -1;
    }

    /* Worst Fit: choose the largest remaining block that fits. */
    for (int i = 0; i < processes; i++) {
        int worst_block = -1;

        for (int j = 0; j < blocks; j++) {
            if (block_size[j] >= process_size[i] &&
                (worst_block == -1 ||
                 block_size[j] > block_size[worst_block])) {
                worst_block = j;
            }
        }

        if (worst_block != -1) {
            allocation[i] = worst_block;
            block_size[worst_block] -= process_size[i];
        }
    }

    printf("\nProcess\tProcess Size\tAllocated Block\n");
    for (int i = 0; i < processes; i++) {
        printf("%d\t%d\t\t", i + 1, process_size[i]);

        if (allocation[i] == -1) {
            printf("Not allocated\n");
        } else {
            printf("%d\n", allocation[i] + 1);
        }
    }

    return 0;
}
