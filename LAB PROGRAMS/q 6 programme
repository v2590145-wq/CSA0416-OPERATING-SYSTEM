#include <stdio.h>

#define MAX_PROCESSES 100

typedef struct {
    int pid;
    int arrival_time;
    int burst_time;
    int remaining_time;
    int priority;
    int completion_time;
    int waiting_time;
    int turnaround_time;
} Process;

int main(void) {
    Process p[MAX_PROCESSES];
    int n, time = 0, completed = 0;

    printf("Enter number of processes (1-%d): ", MAX_PROCESSES);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX_PROCESSES) {
        printf("Invalid number of processes.\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        p[i].pid = i + 1;

        printf("Process %d: enter arrival time, burst time, priority: ",
               p[i].pid);
        if (scanf("%d %d %d", &p[i].arrival_time,
                  &p[i].burst_time, &p[i].priority) != 3 ||
            p[i].arrival_time < 0 || p[i].burst_time <= 0) {
            printf("Invalid input. Arrival time must be nonnegative "
                   "and burst time must be positive.\n");
            return 1;
        }

        p[i].remaining_time = p[i].burst_time;
        p[i].completion_time = 0;
    }

    while (completed < n) {
        int selected = -1;

        /* Select the highest-priority process among those that have arrived. */
        for (int i = 0; i < n; i++) {
            if (p[i].arrival_time <= time && p[i].remaining_time > 0) {
                if (selected == -1 ||
                    p[i].priority < p[selected].priority ||
                    (p[i].priority == p[selected].priority &&
                     p[i].arrival_time < p[selected].arrival_time)) {
                    selected = i;
                }
            }
        }

        if (selected == -1) {
            time++; /* CPU is idle until a process arrives. */
            continue;
        }

        /* Run the selected process for one time unit. */
        p[selected].remaining_time--;
        time++;

        if (p[selected].remaining_time == 0) {
            p[selected].completion_time = time;
            p[selected].turnaround_time =
                p[selected].completion_time - p[selected].arrival_time;
            p[selected].waiting_time =
                p[selected].turnaround_time - p[selected].burst_time;
            completed++;
        }
    }

    double total_waiting = 0.0;
    double total_turnaround = 0.0;

    printf("\nPID\tArrival\tBurst\tPriority\tCompletion\tWaiting\tTurnaround\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t\t%d\t%d\n",
               p[i].pid, p[i].arrival_time, p[i].burst_time,
               p[i].priority, p[i].completion_time,
               p[i].waiting_time, p[i].turnaround_time);

        total_waiting += p[i].waiting_time;
        total_turnaround += p[i].turnaround_time;
    }

    printf("\nAverage waiting time: %.2f\n", total_waiting / n);
    printf("Average turnaround time: %.2f\n", total_turnaround / n);

    return 0;
}
