#include <stdio.h>
#include <stdlib.h>

#define MAX_REQUESTS 100

int main(void)
{
    int requests[MAX_REQUESTS];
    int n, head, diskSize, direction;
    int current;
    long totalMovement = 0;

    printf("Enter number of requests (1-%d): ", MAX_REQUESTS);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX_REQUESTS) {
        printf("Invalid number of requests.\n");
        return 1;
    }

    printf("Enter disk size (number of cylinders): ");
    if (scanf("%d", &diskSize) != 1 || diskSize < 1) {
        printf("Invalid disk size.\n");
        return 1;
    }

    printf("Enter initial head position (0-%d): ", diskSize - 1);
    if (scanf("%d", &head) != 1 || head < 0 || head >= diskSize) {
        printf("Invalid head position.\n");
        return 1;
    }

    printf("Direction (1 = toward higher cylinders, 0 = toward 0): ");
    if (scanf("%d", &direction) != 1 || (direction != 0 && direction != 1)) {
        printf("Invalid direction.\n");
        return 1;
    }

    printf("Enter request cylinder numbers:\n");
    for (int i = 0; i < n; i++) {
        printf("Request %d: ", i + 1);
        if (scanf("%d", &requests[i]) != 1 ||
            requests[i] < 0 || requests[i] >= diskSize) {
            printf("Invalid request position.\n");
            return 1;
        }
    }

    /* Sort requests in ascending order. */
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (requests[j] > requests[j + 1]) {
                int temp = requests[j];
                requests[j] = requests[j + 1];
                requests[j + 1] = temp;
            }
        }
    }

    current = head;
    printf("\nService order: %d", head);

    if (direction == 1) {
        /* Service requests at or above the head. */
        int i = 0;
        while (i < n && requests[i] < head)
            i++;

        for (int j = i; j < n; j++) {
            totalMovement += labs((long)requests[j] - current);
            current = requests[j];
            printf(" -> %d", current);
        }

        /* Reach the upper end, then wrap to cylinder 0. */
        if (current != diskSize - 1) {
            totalMovement += (diskSize - 1) - current;
            current = diskSize - 1;
            printf(" -> %d", current);
        }

        if (current != 0) {
            totalMovement += current;
            current = 0;
            printf(" -> %d", current);
        }

        /* Continue upward from cylinder 0. */
        for (int j = 0; j < i; j++) {
            totalMovement += labs((long)requests[j] - current);
            current = requests[j];
            printf(" -> %d", current);
        }
    } else {
        /* Service requests at or below the head, moving downward. */
        int i = n - 1;
        while (i >= 0 && requests[i] > head)
            i--;

        for (int j = i; j >= 0; j--) {
            totalMovement += labs((long)requests[j] - current);
            current = requests[j];
            printf(" -> %d", current);
        }

        /* Reach cylinder 0, then wrap to the upper end. */
        if (current != 0) {
            totalMovement += current;
            current = 0;
            printf(" -> %d", current);
        }

        if (current != diskSize - 1) {
            totalMovement += (diskSize - 1) - current;
            current = diskSize - 1;
            printf(" -> %d", current);
        }

        /* Continue downward from the upper end. */
        for (int j = n - 1; j > i; j--) {
            totalMovement += labs((long)requests[j] - current);
            current = requests[j];
            printf(" -> %d", current);
        }
    }

    printf("\nTotal head movement: %ld cylinders\n", totalMovement);
    printf("Average movement per request: %.2f cylinders\n",
           (double)totalMovement / n);

    return 0;
}
