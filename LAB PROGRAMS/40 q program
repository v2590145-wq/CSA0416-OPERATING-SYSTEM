#include <stdio.h>
#include <sys/stat.h>
#include <unistd.h>
#include <pwd.h>
#include <grp.h>

void print_permissions(mode_t mode)
{
    printf("Permissions: ");

    printf((mode & S_IRUSR) ? "r" : "-");
    printf((mode & S_IWUSR) ? "w" : "-");
    printf((mode & S_IXUSR) ? "x" : "-");

    printf((mode & S_IRGRP) ? "r" : "-");
    printf((mode & S_IWGRP) ? "w" : "-");
    printf((mode & S_IXGRP) ? "x" : "-");

    printf((mode & S_IROTH) ? "r" : "-");
    printf((mode & S_IWOTH) ? "w" : "-");
    printf((mode & S_IXOTH) ? "x" : "-");

    printf("\n");
}

int main(int argc, char *argv[])
{
    struct stat info;
    struct passwd *user;
    struct group *group;

    printf("Linux file access permissions\n");
    printf("------------------------------\n");
    printf("User classes: Owner (user), Group, Others\n");
    printf("Permission bits: Read (r=4), Write (w=2), Execute (x=1)\n");
    printf("For directories: read lists entries, write changes entries, "
           "execute allows traversal.\n\n");

    user = getpwuid(getuid());
    group = getgrgid(getgid());

    printf("Current user: %s (UID %d)\n",
           user ? user->pw_name : "unknown", (int)getuid());
    printf("Current group: %s (GID %d)\n",
           group ? group->gr_name : "unknown", (int)getgid());

    if (getuid() == 0)
        printf("User type: Root (superuser)\n");
    else
        printf("User type: Regular or service user\n");

    if (argc != 2) {
        printf("\nUsage: %s <file-or-directory>\n", argv[0]);
        printf("Example: %s myfile.txt\n", argv[0]);
        return 1;
    }

    if (stat(argv[1], &info) != 0) {
        perror("Cannot access file");
        return 1;
    }

    printf("\nFile: %s\n", argv[1]);
    printf("Owner UID: %d, Group GID: %d\n",
           (int)info.st_uid, (int)info.st_gid);
    print_permissions(info.st_mode);

    printf("Numeric permissions: %03o\n", info.st_mode & 0777);

    return 0;
}
