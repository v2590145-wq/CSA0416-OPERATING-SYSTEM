#include <stdio.h>
#include <stdlib.h>

#define FILE_NAME "employees.dat"

typedef struct {
    int id;
    char name[50];
    float salary;
    int active;             // 1 = active, 0 = deleted
} Employee;

long recordOffset(int recordNumber)
{
    return (long)(recordNumber - 1) * (long)sizeof(Employee);
}

int readEmployee(FILE *file, int recordNumber, Employee *employee)
{
    if (recordNumber < 1)
        return 0;

    if (fseek(file, recordOffset(recordNumber), SEEK_SET) != 0)
        return 0;

    return fread(employee, sizeof(Employee), 1, file) == 1;
}

void addEmployee(void)
{
    FILE *file = fopen(FILE_NAME, "ab+");
    Employee employee;
    int recordNumber;

    if (file == NULL) {
        perror("Could not open employee file");
        return;
    }

    printf("Enter record number to use: ");
    if (scanf("%d", &recordNumber) != 1 || recordNumber < 1) {
        printf("Invalid record number.\n");
        fclose(file);
        return;
    }

    if (readEmployee(file, recordNumber, &employee) && employee.active) {
        printf("That record number is already occupied.\n");
        fclose(file);
        return;
    }

    printf("Enter employee ID: ");
    if (scanf("%d", &employee.id) != 1) {
        printf("Invalid ID.\n");
        fclose(file);
        return;
    }

    printf("Enter employee name (one word): ");
    if (scanf("%49s", employee.name) != 1) {
        printf("Invalid name.\n");
        fclose(file);
        return;
    }

    printf("Enter salary: ");
    if (scanf("%f", &employee.salary) != 1) {
        printf("Invalid salary.\n");
        fclose(file);
        return;
    }

    employee.active = 1;

    if (fseek(file, recordOffset(recordNumber), SEEK_SET) != 0 ||
        fwrite(&employee, sizeof(Employee), 1, file) != 1) {
        printf("Could not write employee record.\n");
    } else {
        printf("Employee saved in record %d.\n", recordNumber);
    }

    fclose(file);
}

void displayEmployee(void)
{
    FILE *file = fopen(FILE_NAME, "rb");
    Employee employee;
    int recordNumber;

    if (file == NULL) {
        printf("No employee file exists yet.\n");
        return;
    }

    printf("Enter record number to display: ");
    if (scanf("%d", &recordNumber) != 1) {
        printf("Invalid record number.\n");
        fclose(file);
        return;
    }

    if (!readEmployee(file, recordNumber, &employee) || !employee.active) {
        printf("No active employee in that record.\n");
    } else {
        printf("\nRecord number: %d\n", recordNumber);
        printf("Employee ID:   %d\n", employee.id);
        printf("Name:          %s\n", employee.name);
        printf("Salary:        %.2f\n", employee.salary);
    }

    fclose(file);
}

void updateEmployee(void)
{
    FILE *file = fopen(FILE_NAME, "rb+");
    Employee employee;
    int recordNumber;

    if (file == NULL) {
        printf("No employee file exists yet.\n");
        return;
    }

    printf("Enter record number to update: ");
    if (scanf("%d", &recordNumber) != 1) {
        printf("Invalid record number.\n");
        fclose(file);
        return;
    }

    if (!readEmployee(file, recordNumber, &employee) || !employee.active) {
        printf("No active employee in that record.\n");
        fclose(file);
        return;
    }

    printf("Enter new employee ID: ");
    if (scanf("%d", &employee.id) != 1) {
        printf("Invalid ID.\n");
        fclose(file);
        return;
    }

    printf("Enter new name (one word): ");
    if (scanf("%49s", employee.name) != 1) {
        printf("Invalid name.\n");
        fclose(file);
        return;
    }

    printf("Enter new salary: ");
    if (scanf("%f", &employee.salary) != 1) {
        printf("Invalid salary.\n");
        fclose(file);
        return;
    }

    if (fseek(file, recordOffset(recordNumber), SEEK_SET) != 0 ||
        fwrite(&employee, sizeof(Employee), 1, file) != 1) {
        printf("Could not update employee record.\n");
    } else {
        printf("Employee record updated.\n");
    }

    fclose(file);
}

void deleteEmployee(void)
{
    FILE *file = fopen(FILE_NAME, "rb+");
    Employee employee;
    int recordNumber;

    if (file == NULL) {
        printf("No employee file exists yet.\n");
        return;
    }

    printf("Enter record number to delete: ");
    if (scanf("%d", &recordNumber) != 1) {
        printf("Invalid record number.\n");
        fclose(file);
        return;
    }

    if (!readEmployee(file, recordNumber, &employee) || !employee.active) {
        printf("No active employee in that record.\n");
        fclose(file);
        return;
    }

    employee.active = 0;

    if (fseek(file, recordOffset(recordNumber), SEEK_SET) != 0 ||
        fwrite(&employee, sizeof(Employee), 1, file) != 1) {
        printf("Could not delete employee record.\n");
    } else {
        printf("Employee record marked as deleted.\n");
    }

    fclose(file);
}

void listEmployees(void)
{
    FILE *file = fopen(FILE_NAME, "rb");
    Employee employee;
    int recordNumber = 1;

    if (file == NULL) {
        printf("No employee file exists yet.\n");
        return;
    }

    printf("\n%-10s %-10s %-20s %10s\n",
           "Record", "ID", "Name", "Salary");
    printf("------------------------------------------------------\n");

    while (fread(&employee, sizeof(Employee), 1, file) == 1) {
        if (employee.active) {
            printf("%-10d %-10d %-20s %10.2f\n",
                   recordNumber, employee.id, employee.name, employee.salary);
        }
        recordNumber++;
    }

    fclose(file);
}

int main(void)
{
    int choice;

    do {
        printf("\n--- Employee Random Access File ---\n");
        printf("1. Add employee at record number\n");
        printf("2. Display employee by record number\n");
        printf("3. Update employee by record number\n");
        printf("4. Delete employee by record number\n");
        printf("5. List all active employees\n");
        printf("6. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input.\n");
            return EXIT_FAILURE;
        }

        switch (choice) {
            case 1: addEmployee(); break;
            case 2: displayEmployee(); break;
            case 3: updateEmployee(); break;
            case 4: deleteEmployee(); break;
            case 5: listEmployees(); break;
            case 6: printf("Exiting.\n"); break;
            default: printf("Choose a number from 1 to 6.\n");
        }
    } while (choice != 6);

    return EXIT_SUCCESS;
}
