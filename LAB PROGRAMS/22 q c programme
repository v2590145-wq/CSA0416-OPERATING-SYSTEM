#include <stdio.h>

int main(void) {
    int blockCount, processCount;

    printf("Enter the number of memory blocks: ");
    if (scanf("%d", &blockCount) != 1 || blockCount <= 0) {
        printf("Invalid number of blocks.\n");
        return 1;
    }

    int blocks[blockCount];
    int remaining[blockCount];
    int allocated[processCount];

    printf("Enter the size of each memory block:\n");
    for (int i = 0; i < blockCount; i++) {
        scanf("%d", &blocks[i]);
        remaining[i] = blocks[i];
    }

    printf("Enter the number of processes: ");
    if (scanf("%d", &processCount) != 1 || processCount <= 0) {
        printf("Invalid number of processes.\n");
        return 1;
    }

    int processes[processCount];
    int allocation[processCount];

    printf("Enter the size of each process:\n");
    for (int i = 0; i < processCount; i++) {
        scanf("%d", &processes[i]);
        allocation[i] = -1;
    }

    /* Best Fit: choose the smallest remaining block that fits. */
    for (int i = 0; i < processCount; i++) {
        int bestBlock = -1;

        for (int j = 0; j < blockCount; j++) {
            if (remaining[j] >= processes[i] &&
                (bestBlock == -1 || remaining[j] < remaining[bestBlock])) {
                bestBlock = j;
            }
        }

        if (bestBlock != -1) {
            allocation[i] = bestBlock;
            remaining[bestBlock] -= processes[i];
        }
    }

    printf("\nProcess\tSize\tBlock\n");
    for (int i = 0; i < processCount; i++) {
        if (allocation[i] == -1) {
            printf("P%d\t%d\tNot allocated\n", i + 1, processes[i]);
        } else {
            printf("P%d\t%d\t%d\n", i + 1, processes[i],
                   allocation[i] + 1);
        }
    }

    return 0;
}
